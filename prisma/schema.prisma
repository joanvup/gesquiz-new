// Prisma 7: la URL de conexion se configura en prisma7.config.ts (datasource.url),
// NO en este bloque (los campos url/directUrl/shadowDatabaseUrl del datasource
// estan deprecados en Prisma 7).
//
// Para migrar a PostgreSQL en el futuro:
//   1. Cambia `provider = "sqlite"` por `provider = "postgresql"`.
//   2. Cambia DATABASE_URL en .env a
//      "postgresql://user:password@host:5432/quizcolegio" (prisma7.config.ts la lee de env).
//   3. Ejecuta `npx prisma migrate dev --name init-postgres` (generara una linea de
//      migracion nueva; las de SQLite no se reutilizan).
//   4. Prisma 7 exige driver adapter en el cliente: sustituye
//      @prisma/adapter-better-sqlite3 por @prisma/adapter-pg en src/lib/db.ts.
//
// Nota: SQLite no soporta bloques `enum` en Prisma, por lo que los campos de tipo
// enumerado (role, status, tipo, mostrarResultado, formato) son `String` con los
// valores permitidos documentados en comentarios y validados con Zod en la capa de
// aplicacion. Si se migra a PostgreSQL se pueden convertir a `enum`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // "ADMIN" | "TEACHER" | "STUDENT"
  role         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  memberships   GroupMember[]
  quizzes       Quiz[]
  assignments   QuizAssignment[]
  attempts      Attempt[]
  auditEvents   AuditEvent[]
  importBatches ImportBatch[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 (hex) del token en claro que viaja en la cookie
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime? // opcional: sesiones revocables (logout, admin)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members     GroupMember[]
  assignments QuizAssignment[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String // estudiante

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Quiz {
  id                      String   @id @default(cuid())
  teacherId               String
  titulo                  String
  descripcion             String?
  instrucciones           String?
  permitirRetroceso       Boolean  @default(true)
  // Muestra el modal de confirmación al avanzar cuando el retroceso está desactivado.
  advertirAlContinuar     Boolean  @default(false)
  tiempoLimiteMinutos     Int?
  ordenAleatorioPreguntas Boolean  @default(false)
  ordenAleatorioOpciones  Boolean  @default(false)
  intentosPermitidos      Int      @default(1)
  ventanaAbre             DateTime?
  ventanaCierra           DateTime?
  // "NOTA" | "NOTA_Y_RESPUESTAS" | "NADA"
  mostrarResultado        String   @default("NOTA")
  modoSeguro              Boolean  @default(true)
  maxInfracciones         Int      @default(3)
  puntajeMaximo           Float    @default(0) // se recalcula al importar Moodle XML
  publicado               Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  teacher       User              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  questions     Question[]
  assignments   QuizAssignment[]
  attempts      Attempt[]
  importBatches ImportBatch[]
}

model QuizAssignment {
  id        String  @id @default(cuid())
  quizId    String
  groupId   String? // asignacion a grupo...
  studentId String? // ...o a estudiante suelto

  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  group   Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // En SQLite uniques sobre campos nullable permiten multiples NULL
  @@unique([quizId, groupId])
  @@unique([quizId, studentId])
}

model Question {
  id                  String  @id @default(cuid())
  quizId              String
  // "MULTICHOICE" | "TRUEFALSE" | "SHORTANSWER" | "NUMERICAL" | "MATCHING"
  // | "ESSAY" | "DESCRIPTION" | "UNSUPPORTED"
  tipo                String
  enunciadoHtml       String // ya sanitizado en la importacion (fase 2)
  // "html" | "plain_text" | "markdown" | "moodle_auto_format"
  formato             String  @default("html")
  defaultGrade        Float   @default(1)
  penalty             Float   @default(0)
  generalFeedbackHtml String?
  category            String? // etiqueta Moodle, ej. "$course$/top/Matematicas"
  orden               Int
  noPuntua            Boolean @default(false) // DESCRIPTION (informativa) y UNSUPPORTED no puntuan
  datosJson           String? // opciones/pares/tolerancia/comodines (fases 2 y 4)

  quiz     Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options  AnswerOption[]
  attempts AttemptAnswer[]
}

model AnswerOption {
  id           String  @id @default(cuid())
  questionId   String
  orden        Int
  textoHtml    String
  esCorrecta   Boolean @default(false)
  fraction     Float   @default(0) // puntuacion parcial en multichoice multiple
  feedbackHtml String?
  extraJson    String? // clave/valor para shortanswer, numerical+tolerancia, pares matching

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Attempt {
  id                   String   @id @default(cuid())
  quizId               String
  studentId            String
  numeroAttempt        Int // indice de intento (1..intentosPermitidos)
  // "EN_CURSO" | "ENVIADO" | "FINALIZADO_POR_INFRACCIONES" | "EXPIRADO"
  // | "ANULADO" | "CALIFICADO"
  status               String   @default("EN_CURSO")
  startedAt            DateTime @default(now())
  lastActivityAt       DateTime @default(now())
  expiresAt            DateTime?
  submittedAt          DateTime?
  score                Float?
  seed                 String // semilla para orden aleatorio reproducible
  currentQuestionIndex Int      @default(0)
  infractions          Int      @default(0)
  sessionTokenHash     String   @unique // token rotativo del intento (una sesion activa por intento)
  questionOrderJson    String?
  optionOrderJson      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]
  events  AuditEvent[]

  @@unique([quizId, studentId, numeroAttempt])
}

model AttemptAnswer {
  id                    String   @id @default(cuid())
  attemptId             String
  questionId            String
  respuestaJson         String? // respuesta del estudiante en JSON segun tipo
  respuestaTexto        String?
  puntuacion            Float?
  esCorrecta            Boolean?
  calificadaManualmente Boolean   @default(false)
  answeredAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  attemptId String?
  userId    String?
  // "INICIO_INTENTO" | "FIN_INTENTO" | "INFRACCION_FULLSCREEN_EXIT"
  // | "INFRACCION_VISIBILIDAD" | "INFRACCION_BLUR" | "HEARTBEAT_PERDIDO"
  // | "AUTO_ENVIO_POR_INFRACCIONES" | "EXPIRACION_TIEMPO" | "REAPERTURA"
  // | "ANULACION" | ...
  tipo      String
  detalle   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  attempt Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ImportBatch {
  id         String   @id @default(cuid())
  teacherId  String
  quizId     String?
  fileName   String
  createdAt  DateTime @default(now())
  reportJson String // reporte de importacion (fase 2)

  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  quiz    Quiz? @relation(fields: [quizId], references: [id], onDelete: SetNull)
}
